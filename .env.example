# Helpdesk local config — copy to .env and fill in. NEVER commit .env.
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=helpdesk
DATABASE_URL=postgresql+asyncpg://helpdesk:change-me@localhost:5432/helpdesk
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
# Timeout, in seconds, on every Qdrant request the ingest makes.
QDRANT_TIMEOUT_SECONDS=30
GATEWAY_URL=http://localhost:8080/v1
# Where the MCP server's streamable HTTP transport is mounted. Must be an
# absolute http(s) URL; a malformed value fails at startup, not on first turn.
MCP_URL=http://localhost:8081/mcp
# One key per tenant slug: tenant:key,tenant:key. The gateway
# refuses a request whose X-Tenant does not match the key it presents.
GATEWAY_API_KEYS=nordlicht:replace-me,cuan:replace-me
# The corpus root ingestion walks, as {tenant}/{version}/{file}. Point it at
# your own folder to run this repository against your policies, then re-ingest
# with `make ingest TENANT=... VERSION=...`.
POLICY_DIR=policies
# Where fastembed keeps its models. Inside the repo, never ~/.cache.
EMBEDDING_CACHE_DIR=.cache/fastembed
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Web
# Where the web app's server side reaches agent-api. Read on the server only:
# the browser talks to the Next origin and never to agent-api directly.
AGENT_API_URL=http://localhost:8000
# Whether the session cookie carries Secure. Leave false for plain-http local
# development; anything other than "false" is treated as true.
SESSION_COOKIE_SECURE=false
# The one browser origin agent-api answers cross-origin requests from. It is
# an origin, so scheme, host and port only: no trailing slash and no path, or
# it matches no browser request and every call fails with no server error.
WEB_ORIGIN=http://localhost:3000
ENV=dev
# E2E. Where Playwright drives the built web app, and the port the
# stub gateway listens on during `make e2e`. The stub replaces the model and
# nothing else; every other process in the run is the shipped code.
E2E_BASE_URL=http://localhost:3000
E2E_STUB_GATEWAY_PORT=8099
# Where Playwright keeps its browser binaries. Inside the repo, never ~/.cache
# or ~/Library, so nothing installs outside the project folder.
PLAYWRIGHT_BROWSERS_PATH=.cache/playwright
# AI
# LLM_API_KEY=replace-me
# LANGFUSE_PUBLIC_KEY=replace-me
# LANGFUSE_SECRET_KEY=replace-me
# LANGFUSE_HOST=https://cloud.langfuse.com
