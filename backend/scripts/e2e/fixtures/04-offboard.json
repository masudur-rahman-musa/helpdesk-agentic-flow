{
  "match": "offboard them",
  "steps": [
    [
      {
        "name": "find_person",
        "arguments": {
          "words": "{accounts.sod_employee.displayName}"
        }
      }
    ],
    [
      {
        "name": "offboard_user",
        "arguments": {
          "user_id": "{find_person.people.0.user_id}",
          "end_date": "{today+0}"
        }
      }
    ]
  ],
  "reply": "Done. The details are below."
}
