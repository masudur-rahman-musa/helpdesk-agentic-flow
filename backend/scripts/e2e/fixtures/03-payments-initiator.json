{
  "match": "payments.initiator",
  "steps": [
    [
      {
        "name": "search_policy",
        "arguments": {
          "query": "Who may raise payment runs?"
        }
      },
      {
        "name": "find_role",
        "arguments": {
          "words": "payments.initiator"
        }
      },
      {
        "name": "get_me",
        "arguments": {}
      }
    ],
    [
      {
        "name": "create_access_request",
        "arguments": {
          "target_user_id": "{get_me.user_id}",
          "role_id": "{find_role.roles.0.role_id}",
          "justification": "I need to raise payment runs."
        }
      }
    ]
  ],
  "reply": "Done. The details are below."
}
