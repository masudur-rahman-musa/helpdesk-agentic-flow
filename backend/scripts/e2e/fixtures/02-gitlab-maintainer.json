{
  "match": "gitlab.maintainer",
  "steps": [
    [
      {
        "name": "search_policy",
        "arguments": {
          "query": "Who approves maintainer rights on GitLab?"
        }
      },
      {
        "name": "find_role",
        "arguments": {
          "words": "gitlab.maintainer"
        }
      },
      {
        "name": "get_me",
        "arguments": {}
      }
    ],
    [
      {
        "name": "create_access_request",
        "arguments": {
          "target_user_id": "{get_me.user_id}",
          "role_id": "{find_role.roles.0.role_id}",
          "justification": "I am running the repository migration and need maintainer rights."
        }
      }
    ]
  ],
  "reply": "Done. The details are below."
}
