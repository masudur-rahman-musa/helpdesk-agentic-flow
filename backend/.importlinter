[importlinter]
# The one rule the restructure adds: the three apps lean on the shared library
# and never on each other, and the shared library never reaches back into an
# app. `lint-imports` is run from backend/ in CI and by
# tests/shared/test_import_contracts.py.
root_package = helpdesk

[importlinter:contract:apps-are-independent]
name = The three apps never import each other
type = independence
modules =
    helpdesk.agent_api
    helpdesk.mcp_server
    helpdesk.scheduler

[importlinter:contract:shared-imports-no-app]
name = The shared library imports no app
type = forbidden
source_modules =
    helpdesk.shared
forbidden_modules =
    helpdesk.agent_api
    helpdesk.mcp_server
    helpdesk.scheduler

[importlinter:contract:audit-is-one-way]
name = The audit package is a one-way dependency — access, killswitch, and the scheduler jobs all read it, and none of its own modules reach back into those callers
type = forbidden
source_modules =
    helpdesk.shared.audit
forbidden_modules =
    helpdesk.shared.access
    helpdesk.shared.services.killswitch
    helpdesk.scheduler.jobs
