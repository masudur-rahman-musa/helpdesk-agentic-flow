# Helpdesk local config — copy to .env and fill in. NEVER commit .env.
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=helpdesk
# The OWNER DSN. Alembic and the test suite need it: migrations are DDL and the
# suite creates and drops throwaway databases, neither of which the restricted
# role below can or should do.
DATABASE_URL=postgresql+asyncpg://helpdesk:change-me@localhost:5432/helpdesk
# The restricted application role. It holds SELECT and INSERT on audit_events
# and nothing more, so a compromised service cannot rewrite or truncate the
# log; an UPDATE as this role is refused by the privilege check (SQLSTATE
# 42501) before the append-only trigger is ever reached. The role name is fixed
# in the migration and is deliberately not configurable.
#
# APP_DB_PASSWORD is read by the compose postgres init script on a fresh pgdata
# volume, and by the three app containers, which build their own DSN from it.
# APP_DATABASE_URL is the same credentials in host spelling, for a service run
# outside compose.
APP_DB_PASSWORD=change-me-too
APP_DATABASE_URL=postgresql+asyncpg://helpdesk_app:change-me-too@localhost:5432/helpdesk
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
# Timeout, in seconds, on every Qdrant request the ingest makes.
QDRANT_TIMEOUT_SECONDS=30
# Start of every policy collection name, seven characters at most. Leave as is
# for real use; the tests set their own so they never touch the live collections.
QDRANT_COLLECTION_PREFIX=policy_
GATEWAY_URL=http://localhost:8080/v1
# Where the MCP server's streamable HTTP transport is mounted. Must be an
# absolute http(s) URL; a malformed value fails at startup, not on first turn.
MCP_URL=http://localhost:8081/mcp
# The Host headers the MCP transport accepts; anything else is answered 421.
# This list REPLACES the default, so add the loopback names back if you widen
# it: a deployment reached by a cluster service or an ingress hostname sets
# that name here. Empty or whitespace-bearing entries fail at startup.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,helpdesk-mcp-server:*
# One key per tenant slug: tenant:key,tenant:key. The gateway
# refuses a request whose X-Tenant does not match the key it presents.
GATEWAY_API_KEYS=nordlicht:replace-me,cuan:replace-me
# The corpus root ingestion walks, as {tenant}/{version}/{file}. Point it at
# your own folder to run this repository against your policies, then re-ingest
# with `make ingest TENANT=... VERSION=...`.
POLICY_DIR=policies
# Where fastembed keeps its models. Inside the repo, never ~/.cache.
EMBEDDING_CACHE_DIR=.cache/fastembed
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Web
# Where the web app's server side reaches agent-api. Read on the server only:
# the browser talks to the Next origin and never to agent-api directly.
AGENT_API_URL=http://localhost:8000
# Whether the session cookie carries Secure. Leave false for plain-http local
# development; anything other than "false" is treated as true.
SESSION_COOKIE_SECURE=false
# The one browser origin agent-api answers cross-origin requests from. It is
# an origin, so scheme, host and port only: no trailing slash and no path, or
# it matches no browser request and every call fails with no server error.
WEB_ORIGIN=http://localhost:3000
ENV=dev
# E2E. Where Playwright drives the built web app, and the port the
# stub gateway listens on during `make e2e`. The stub replaces the model and
# nothing else; every other process in the run is the shipped code.
E2E_BASE_URL=http://localhost:3000
E2E_STUB_GATEWAY_PORT=8099
# Where Playwright keeps its browser binaries. Inside the repo, never ~/.cache
# or ~/Library, so nothing installs outside the project folder.
PLAYWRIGHT_BROWSERS_PATH=.cache/playwright
# Cut-offs the tools decide by, each 0 to 1 inclusive. Tune against the conversation cases.
ROLE_SUGGESTION_FLOOR=
POLICY_REFUSAL_FLOOR=
# true saves each step of a chat turn (LangGraph checkpoints); needs `python -m helpdesk.agent_api.cli` first.
SAVE_TURN_STEPS=
# true turns on POST /admin/test/reset and POST /v1/eval/conversation for `make eval-chat`. Never in production.
EVAL_ROUTES_ENABLED=
# AI
# LLM_API_KEY=replace-me
# LANGFUSE_PUBLIC_KEY=replace-me
# LANGFUSE_SECRET_KEY=replace-me
# LANGFUSE_HOST=https://cloud.langfuse.com
