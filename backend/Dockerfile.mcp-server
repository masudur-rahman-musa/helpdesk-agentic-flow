# syntax=docker/dockerfile:1

# The mcp-server service. Each app has its own Dockerfile: the build context is
# `backend/` and each image carries only the shared library plus its own app
# package and its own dependency group. This is the only image that carries fastembed and
# its two embedding models.
#
#   docker build -f backend/Dockerfile.mcp-server -t helpdesk-mcp-server:local backend
#
# No migration runs in this image. The policy corpus is NOT
# copied in: it arrives as a read-only runtime mount, so the corpus that
# decides access is not pinned to a build. Pinned by
# backend/tests/shared/test_container_build.py.

# Pinned by digest-free exact tags; held at or above a recorded floor by
# backend/tests/shared/test_container_build.py.
ARG PYTHON_IMAGE=python:3.12.15-slim-bookworm
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.19

FROM ${UV_IMAGE} AS uv

# --- build stage: resolve and install the project into its own venv ----------
FROM ${PYTHON_IMAGE} AS builder

COPY --from=uv /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

COPY pyproject.toml uv.lock ./

# --group mcp-server brings fastembed, which the other two images skip so they
# stay small.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --group mcp-server

COPY helpdesk/__init__.py helpdesk/__init__.py
COPY helpdesk/shared helpdesk/shared
COPY helpdesk/mcp_server helpdesk/mcp_server

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --group mcp-server

# --- runtime stage: the venv, the source, and one unprivileged account -------
FROM ${PYTHON_IMAGE} AS runtime

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN groupadd --gid 10001 helpdesk \
 && useradd --uid 10001 --gid 10001 --home-dir /nonexistent --no-create-home helpdesk

# The pinned Python image still ships libssl3 3.0.22-1~deb12u1, which carries a
# HIGH CVE fixed in deb12u2. Upgrading the OpenSSL packages here clears it
# without waiting for a new base image; drop this once the base has it.
RUN apt-get update \
 && apt-get install -y --only-upgrade --no-install-recommends libssl3 openssl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder --chown=10001:10001 /app /app

# `/app` itself belongs to root (WORKDIR made it), so the model cache folder
# filled below is made here, as root, and handed to uid 10001.
RUN mkdir -p /app/.cache/fastembed && chown -R 10001:10001 /app/.cache

# After the last COPY, so no later --chown puts the process back on uid 0.
USER 10001:10001

# The two embedding models, built into this image only. On the cluster
# `apps` has no route to the internet, so the models cannot be fetched at
# start; they land in `.cache/fastembed`, the path `embedding_cache_dir`
# reads, and the Deployment sets `HF_HUB_OFFLINE=1`.
RUN HF_HOME=/tmp/hf python -c "from fastembed import SparseTextEmbedding, TextEmbedding; \
TextEmbedding(model_name='BAAI/bge-small-en-v1.5', cache_dir='.cache/fastembed'); \
SparseTextEmbedding(model_name='Qdrant/bm25', cache_dir='.cache/fastembed')" \
 && rm -rf /tmp/hf

EXPOSE 8081

ENTRYPOINT ["uvicorn", "helpdesk.mcp_server.main:app", "--host", "0.0.0.0", "--port", "8081"]
