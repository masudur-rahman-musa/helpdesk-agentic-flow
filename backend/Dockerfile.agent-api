# syntax=docker/dockerfile:1

# The agent-api service of the design. Restructure an earlier change split the one
# build-arg Dockerfile into three, one per app: the build context is `backend/`
# and each image carries only the shared library plus its own app package and
# its own dependency group.
#
#   docker build -f backend/Dockerfile.agent-api -t helpdesk-agent-api:local backend
#
# No migration runs in this image (decision D1): a project rule keeps Alembic
# against the local compose database, and an entrypoint that upgraded on start
# would have every replica of a rollout racing the same migration.
#
# The policy corpus is NOT copied in: it arrives as a read-only runtime mount,
# so the corpus that decides access is not pinned to a build. Pinned by
# backend/tests/shared/test_container_build.py.

# Pinned by digest-free exact tags so a rebuild is reproducible within a patch
# line and a bump is a visible diff here. Held at or above a recorded floor by
# backend/tests/shared/test_container_build.py; the weekly image-scan only
# confirms what they carry.
ARG PYTHON_IMAGE=python:3.12.15-slim-bookworm
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.19

FROM ${UV_IMAGE} AS uv

# --- build stage: resolve and install the project into its own venv ----------
FROM ${PYTHON_IMAGE} AS builder

COPY --from=uv /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Manifests first, on their own layer: dependency resolution is the slow half
# of this build and is invalidated only when a manifest changes.
COPY pyproject.toml uv.lock ./

# --no-dev keeps ruff, mypy, pytest and locust out of a runtime image;
# --frozen makes a manifest that drifted from the lockfile fail here rather
# than resolve to something nobody tested; --group installs this app's extras.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --group agent-api

# Only the shared library and this app's package land in the image.
COPY helpdesk/__init__.py helpdesk/__init__.py
COPY helpdesk/shared helpdesk/shared
COPY helpdesk/agent_api helpdesk/agent_api

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --group agent-api

# --- runtime stage: the venv, the source, and one unprivileged account -------
FROM ${PYTHON_IMAGE} AS runtime

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# A fixed uid so a bind mount's ownership is predictable across machines.
RUN groupadd --gid 10001 helpdesk \
 && useradd --uid 10001 --gid 10001 --home-dir /nonexistent --no-create-home helpdesk

WORKDIR /app

COPY --from=builder --chown=10001:10001 /app /app

# After the last COPY, so no later --chown puts the process back on uid 0.
USER 10001:10001

EXPOSE 8000

# `exec` so the server is pid 1 and receives SIGTERM directly.
ENTRYPOINT ["uvicorn", "helpdesk.agent_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
