# syntax=docker/dockerfile:1

# The scheduler service. Each app has its own Dockerfile: the build context is
# `backend/` and each image carries only the shared library plus its own app
# package and its own dependency group.
#
#   docker build -f backend/Dockerfile.scheduler -t helpdesk-scheduler:local backend
#
# No migration runs in this image. The policy corpus is NOT
# copied in: it arrives as a read-only runtime mount. Pinned by
# backend/tests/shared/test_container_build.py.

# Pinned by digest-free exact tags; held at or above a recorded floor by
# backend/tests/shared/test_container_build.py.
ARG PYTHON_IMAGE=python:3.12.15-slim-bookworm
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.19

FROM ${UV_IMAGE} AS uv

# --- build stage: resolve and install the project into its own venv ----------
FROM ${PYTHON_IMAGE} AS builder

COPY --from=uv /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

COPY pyproject.toml uv.lock ./

# The scheduler carries no app-specific extras (its dependency group is empty),
# so --group scheduler installs the base set only.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --group scheduler

COPY helpdesk/__init__.py helpdesk/__init__.py
COPY helpdesk/shared helpdesk/shared
COPY helpdesk/scheduler helpdesk/scheduler

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --group scheduler

# --- runtime stage: the venv, the source, and one unprivileged account -------
FROM ${PYTHON_IMAGE} AS runtime

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN groupadd --gid 10001 helpdesk \
 && useradd --uid 10001 --gid 10001 --home-dir /nonexistent --no-create-home helpdesk

WORKDIR /app

COPY --from=builder --chown=10001:10001 /app /app

USER 10001:10001

EXPOSE 8082

ENTRYPOINT ["uvicorn", "helpdesk.scheduler.main:app", "--host", "0.0.0.0", "--port", "8082"]
